<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="eclipse_ros2_control" params="use_mock_base use_mock_arm use_mock_ct mock_sensor_commands with_base with_arm with_camera_tower can_port_name arm_u2d2_port_name arm2_u2d2_port_name ct_u2d2_port_name">

    <xacro:if value="${with_base}">
      <ros2_control name="eclipse_base" type="system">

        <hardware>
          <xacro:if value="${use_mock_base}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param>
            <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          </xacro:if>

          <xacro:unless value="${use_mock_base}">
            <plugin>rmd_hardware_interface/RmdHardwareInterface</plugin>
            <param name="port_name">${can_port_name}</param>
            <param name="baud_rate">1000000</param>
            <param name="base_accel_limit_dps2">20000</param>
            <param name="base_decel_limit_dps2">20000</param>
            <param name="auto_zero_on_activate">true</param>
            <param name="flipper_rpm_limit">30</param>
            <param name="max_base_rpm">150</param>
            <!-- auto=true -> force-position(A9), auto=false -> position(A4) -->
            <param name="flipper_auto_mode_topic">/flipper_auto_mode</param>

          </xacro:unless>
        </hardware>

        <joint name="left_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="current"/>
          <param name="id">2</param>
          <param name="direction">-1</param>
        </joint>
        <joint name="right_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="current"/>
          <param name="id">1</param>
        </joint>

        <joint name="fl_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="current"/>
          <param name="id">5</param>
        </joint>
        <joint name="fr_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="current"/>
          <param name="id">4</param>
        </joint>
        <joint name="bl_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="current"/>
          <param name="id">6</param>
        </joint>
        <joint name="br_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="current"/>
          <param name="id">3</param>
        </joint>

      </ros2_control>
    </xacro:if>


    <xacro:if value="${with_arm}">
      <ros2_control name="eclipse_arm" type="system">

        <hardware>
          <xacro:if value="${use_mock_arm}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          </xacro:if>

          <xacro:unless value="${use_mock_arm}">
            <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
            <param name="port_name">${arm_u2d2_port_name}</param>
            <param name="baud_rate">1000000</param>
            <param name="dynamixel_model_folder">/param/dxl_model/</param>
            <param name="number_of_joints">5</param>
            <param name="number_of_transmissions">5</param>
            <param name="loop_rate">100</param>
            <param name="use_fast_read">false</param>
            <param name="use_indirect_address">true</param>
            <param name="error_timeout_ms">4000</param>
            <param name="disable_torque_at_init">false</param>
            <param name="torque_enable">true</param>
          </xacro:unless>
        </hardware>

        <joint name="arm_joint1">
          <param name="id">10</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="arm_joint2">
          <param name="id">11</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="arm_joint3">
          <param name="id">12</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="arm_joint4">
          <param name="id">13</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="arm_joint6">
          <param name="id">15</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <gpio name="dxl10">
          <param name="type">dxl</param>
          <param name="ID">10</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">2830</param>
          <param name="Profile Acceleration">1596050</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl11">
          <param name="type">dxl</param>
          <param name="ID">11</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">2900</param>
          <param name="Profile Acceleration">1596050</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl12">
          <param name="type">dxl</param>
          <param name="ID">12</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">2900</param>
          <param name="Profile Acceleration">1596050</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl13">
          <param name="type">dxl</param>
          <param name="ID">13</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">2920</param>
          <param name="Profile Acceleration">1596050</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl15">
          <param name="type">dxl</param>
          <param name="ID">15</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">2600</param>
          <param name="Profile Acceleration">10867</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
      </ros2_control>
    </xacro:if>


    <xacro:if value="${with_arm}">
      <ros2_control name="eclipse_arm2" type="system">

        <hardware>
          <xacro:if value="${use_mock_arm}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          </xacro:if>

          <xacro:unless value="${use_mock_arm}">
            <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
            <param name="port_name">${arm2_u2d2_port_name}</param>
            <param name="baud_rate">1000000</param>
            <param name="dynamixel_model_folder">/param/dxl_model/</param>
            <param name="number_of_joints">3</param>
            <param name="number_of_transmissions">3</param>
            <param name="loop_rate">100</param>
            <param name="use_fast_read">false</param>
            <param name="use_indirect_address">true</param>
            <param name="error_timeout_ms">4000</param>
            <param name="disable_torque_at_init">false</param>
            <param name="torque_enable">true</param>
          </xacro:unless>
        </hardware>

        <joint name="arm_joint5">
          <param name="id">14</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="gripper_motor_rjoint">
          <param name="id">16</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="gripper_motor_ljoint">
          <param name="id">17</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <gpio name="dxl14">
          <param name="type">dxl</param>
          <param name="ID">14</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">32767</param>
          <param name="Profile Acceleration">10867</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl16">
          <param name="type">dxl</param>
          <param name="ID">16</param>
          <param name="Operating Mode">5</param>
          <param name="Goal Current">298</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">20000</param>
          <param name="Profile Acceleration">5000</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl17">
          <param name="type">dxl</param>
          <param name="ID">17</param>
          <param name="Operating Mode">5</param>
          <param name="Goal Current">298</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">20000</param>
          <param name="Profile Acceleration">5000</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Current"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
      </ros2_control>
    </xacro:if>


    <xacro:if value="${with_camera_tower}">
      <ros2_control name="eclipse_camera_tower" type="system">

        <hardware>
          <xacro:if value="${use_mock_ct}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          </xacro:if>

          <xacro:unless value="${use_mock_ct}">
            <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
            <param name="port_name">${ct_u2d2_port_name}</param>
            <param name="baud_rate">1000000</param>
            <param name="dynamixel_model_folder">/param/dxl_model/</param>
            <param name="number_of_joints">4</param>
            <param name="number_of_transmissions">4</param>
            <param name="loop_rate">100</param>
            <param name="use_fast_read">false</param>
            <param name="use_indirect_address">true</param>
            <param name="error_timeout_ms">4000</param>
            <param name="disable_torque_at_init">false</param>
            <param name="torque_enable">true</param>
          </xacro:unless>
        </hardware>

        <joint name="ct_joint1_1">
          <param name="id">20</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="ct_joint1_2">
          <param name="id">21</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/> 
          <state_interface name="velocity"/>
        </joint>
        <joint name="ct_joint2_1">
          <param name="id">22</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="ct_joint2_2">
          <param name="id">23</param>
          <param name="torque_enable">true</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <gpio name="dxl20">
          <param name="type">dxl</param>
          <param name="ID">20</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">0</param>
          <param name="Profile Acceleration">0</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl21">
          <param name="type">dxl</param>
          <param name="ID">21</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">0</param>
          <param name="Profile Acceleration">0</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl22">
          <param name="type">dxl</param>
          <param name="ID">22</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">0</param>
          <param name="Profile Acceleration">0</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
        <gpio name="dxl23">
          <param name="type">dxl</param>
          <param name="ID">23</param>
          <param name="Operating Mode">3</param>
          <param name="Return Delay Time">10</param>
          <param name="Profile Velocity">0</param>
          <param name="Profile Acceleration">0</param>
          <param name="Torque Enable">1</param>
          <command_interface name="Goal Position"/>
          <state_interface name="Present Position"/>
          <state_interface name="Present Velocity"/>
          <state_interface name="Hardware Error Status"/>
        </gpio>
      </ros2_control>
    </xacro:if>

  </xacro:macro>
</robot>
